#include <stdio.h>
#include <stdlib.h>

typedef struct No {
    int valor;
    struct No *proximo;
} No;

void inserirPosicao(No **head, int valor, int posicao) {
    if (posicao < 0) {
        printf("Erro: posicao invalida (%d)\n", posicao);
        return;
    }

    No *novo = (No *)malloc(sizeof(No));
    novo->valor = valor;
    novo->proximo = NULL;

    if (posicao == 0) {
        novo->proximo = *head;
        *head = novo;
        return;
    }

    No *atual = *head;
    for (int i = 0; i < posicao - 1; i++) {
        if (atual == NULL) {
            printf("Erro: posicao invalida (%d)\n", posicao);
            free(novo);
            return;
        }
        atual = atual->proximo;
    }

    novo->proximo = atual->proximo;
    atual->proximo = novo;
}

void imprimir(No *head) {
    No *atual = head;
    while (atual != NULL) {
        printf("%d -> ", atual->valor);
        atual = atual->proximo;
    }
    printf("NULL\n");
}

void liberarLista(No **head) {
    No *atual = *head;
    while (atual != NULL) {
        No *temp = atual;
        atual = atual->proximo;
        free(temp);
    }
    *head = NULL;
}

int main() {
    No *lista = NULL;

    inserirPosicao(&lista, 10, 0);
    inserirPosicao(&lista, 20, 1);
    inserirPosicao(&lista, 30, 2);
    printf("Antes: ");
    imprimir(lista);

    inserirPosicao(&lista, 99, 1);
    printf("Depois: ");
    imprimir(lista);

    liberarLista(&lista);
    return 0;
}

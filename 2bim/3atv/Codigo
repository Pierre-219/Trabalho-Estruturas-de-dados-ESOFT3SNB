        printf("3 - Remover palavra\n");
        printf("4 - Exibir tabela\n");
        printf("5 - Exibir estatisticas\n");
        printf("0 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);
        getchar();

        switch (opcao) {
            case 1:
                printf("Palavra: ");
                fgets(palavra, TAM_PALAVRA, stdin);
                palavra[strcspn(palavra, "\n")] = '\0';
                printf("Definicao: ");
                fgets(definicao, TAM_DEFINICAO, stdin);
                definicao[strcspn(definicao, "\n")] = '\0';
                inserir(&tabela, palavra, definicao);
                break;

            case 2:
                printf("Palavra para buscar: ");
                fgets(palavra, TAM_PALAVRA, stdin);
                palavra[strcspn(palavra, "\n")] = '\0';
                resultado = buscar(&tabela, palavra);
                if (resultado != NULL)
                    printf("Encontrada: \"%s\" -> %s\n", resultado->palavra, resultado->definicao);
                else
                    printf("Palavra \"%s\" nao encontrada.\n", palavra);
                break;

            case 3:
                printf("Palavra para remover: ");
                fgets(palavra, TAM_PALAVRA, stdin);
                palavra[strcspn(palavra, "\n")] = '\0';
                remover(&tabela, palavra);
                break;

            case 4:
                exibir_tabela(&tabela);
                break;

            case 5:
                exibir_estatisticas(&tabela);
                break;

            case 0:
                printf("Encerrando...\n");
                break;

            default:
                printf("Opcao invalida.\n");
        }

        printf("\n");
    } while (opcao != 0);

    liberar_tabela(&tabela);
    return 0;
}


void exibir_tabela(TabelaHash *tabela) {
    printf("        TABELA HASH - DICIONARIO\n");

    for (int i = 0; i < TAMANHO_TABELA; i++) {
        printf("[%2d] ", i);
        if (tabela->buckets[i] == NULL) {
            printf("(vazio)\n");
        } else {
            No *atual = tabela->buckets[i];
            int primeiro = 1;
            while (atual != NULL) {
                if (!primeiro) printf("     -> ");
                printf("\"%s\": %s\n", atual->palavra, atual->definicao);
                primeiro = 0;
                atual = atual->proximo;
            }
        }
    }
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define TAMANHO_TABELA 13
#define TAM_PALAVRA 100
#define TAM_DEFINICAO 500

typedef struct No {
    char palavra[TAM_PALAVRA];
    char definicao[TAM_DEFINICAO];
    struct No *proximo;
} No;

typedef struct {
    No *buckets[TAMANHO_TABELA];
    int total_elementos;
    int total_colisoes;
} TabelaHash;

unsigned int funcao_hash(const char *palavra) {
    unsigned int hash = 5381;
    int c;
    while ((c = (unsigned char)*palavra++)) {
        hash = hash * 31 + c;
    }
    return hash % TAMANHO_TABELA;
}

void inicializar_tabela(TabelaHash *tabela) {
    for (int i = 0; i < TAMANHO_TABELA; i++) {
        tabela->buckets[i] = NULL;
    }
    tabela->total_elementos = 0;
    tabela->total_colisoes = 0;
}
Parte 2
void inserir(TabelaHash *tabela, const char *palavra, const char *definicao) {
    unsigned int indice = funcao_hash(palavra);
    No *atual = tabela->buckets[indice];

    while (atual != NULL) {
        if (strcmp(atual->palavra, palavra) == 0) {
            strncpy(atual->definicao, definicao, TAM_DEFINICAO - 1);
            atual->definicao[TAM_DEFINICAO - 1] = '\0';
            printf("Definição de \"%s\" atualizada.\n", palavra);
            return;
        }
        atual = atual->proximo;
    }

    No *novo = (No *)malloc(sizeof(No));
    if (novo == NULL) {
        printf("Erro: sem memória para inserir \"%s\".\n", palavra);
        return;
    }

    strncpy(novo->palavra, palavra, TAM_PALAVRA - 1);
    novo->palavra[TAM_PALAVRA - 1] = '\0';
    strncpy(novo->definicao, definicao, TAM_DEFINICAO - 1);
    novo->definicao[TAM_DEFINICAO - 1] = '\0';

    if (tabela->buckets[indice] != NULL) {
        tabela->total_colisoes++;
    }

    novo->proximo = tabela->buckets[indice];
    tabela->buckets[indice] = novo;
    tabela->total_elementos++;

    printf("Palavra \"%s\" inserida no índice %u.\n", palavra, indice);
}

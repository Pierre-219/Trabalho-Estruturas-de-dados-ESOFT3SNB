
#include <stdio.h>
#include <stdlib.h>

// --- FUNÇÃO ADICIONADA: Fibonacci Ingênuo (sem cache) ---
long long fibonacciIngenuo(int n, long long *chamadas) {
    (*chamadas)++;

    if (n == 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }

    return fibonacciIngenuo(n - 1, chamadas) + fibonacciIngenuo(n - 2, chamadas);
}

// Sua função memoizada (está correta!)
long long fibonacciMemoizado(int n, long long *cache, long long *chamadas) {
    (*chamadas)++;

    if (n == 0) {
        return 0;
    }

    if (n == 1) {
        return 1;
    }

    // Se o valor já foi calculado, retorna direto
    if (cache[n] != -1) {
        return cache[n];
    }

    // Calcula e guarda no cache
    cache[n] = fibonacciMemoizado(n - 1, cache, chamadas) +
               fibonacciMemoizado(n - 2, cache, chamadas);

    return cache[n];
}

int main() {
    int n;
    long long chamadasIngenuo = 0;
    long long chamadasMemoizado = 0;

    printf("Digite o valor de n: ");
    if (scanf("%d", &n) != 1) { // Uma boa prática para validar a entrada
        printf("Entrada invalida.\n");
        return 1;
    }

    if (n < 0) {
        printf("Valor invalido. Digite um numero maior ou igual a zero.\n");
        return 1;
    }

    // Alocação dinâmica do cache
    long long *cache = malloc((n + 1) * sizeof(long long));

    if (cache == NULL) {
        printf("Erro ao alocar memoria.\n");
        return 1;
    }

    // Inicializa o cache com -1
    for (int i = 0; i <= n; i++) {
        cache[i] = -1;
    }

    // Agora ambas as funções existem e vão rodar!
    long long resultadoIngenuo = fibonacciIngenuo(n, &chamadasIngenuo);
    long long resultadoMemoizado = fibonacciMemoizado(n, cache, &chamadasMemoizado);

    printf("\nResultado Fibonacci ingenuo: %lld\n", resultadoIngenuo);
    printf("Chamadas recursivas ingenuo: %lld\n", chamadasIngenuo);

    printf("\nResultado Fibonacci memoizado: %lld\n", resultadoMemoizado);
    printf("Chamadas recursivas memoizado: %lld\n", chamadasMemoizado);

    free(cache);

    return 0;
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char nome[100];
    float nota;
} Aluno;


Aluno* maiorNota(Aluno *alunos, int n) {
    if (n <= 0) return NULL;
    
    Aluno *maior = alunos;  
    
    for (int i = 1; i < n; i++) {
        if ((alunos + i)->nota > maior->nota) {
            maior = alunos + i;
        }
    }
    return maior;
}

int main() {
    int n;
    Aluno *turma = NULL;
    
    printf("Digite a quantidade de alunos: ");
    scanf("%d", &n);
    getchar();  
    
    // Alocação dinâmica
    turma = (Aluno*) malloc(n * sizeof(Aluno));
    if (turma == NULL) {
        printf("Erro de alocação de memória!\n");
        return 1;
    }
    
    for (int i = 0; i < n; i++) {
        printf("\nAluno %d:\n", i+1);
        printf("Nome: ");
        fgets(turma[i].nome, 100, stdin);
        turma[i].nome[strcspn(turma[i].nome, "\n")] = '\0';  
        
        printf("Nota: ");
        scanf("%f", &turma[i].nota);
        getchar();  // consome newline
    }
    
    // Chama a função
    Aluno *melhor = maiorNota(turma, n);
    
    if (melhor != NULL) {
        printf("\n=== Aluno com maior nota ===\n");
        printf("Nome: %s\n", melhor->nome);
        printf("Nota: %.2f\n", melhor->nota);
    }
    
    free(turma);  
    return 0;
}

#include <stdio.h>


int ordenaTres(int *a, int *b, int *c) {
    int temp;
    
   
    if (*a > *b) {
        temp = *a; *a = *b; *b = temp;
    }
    if (*a > *c) {
        temp = *a; *a = *c; *c = temp;
    }
    if (*b > *c) {
        temp = *b; *b = *c; *c = temp;
    }
    
    
    if (*a == *b && *b == *c)
        return 1;
    else
        return 0;
}

int main() {
    int x, y, z;
    
    printf("Digite três valores inteiros: ");
    scanf("%d %d %d", &x, &y, &z);
    
    int igual = ordenaTres(&x, &y, &z);
    
    printf("Valores ordenados: %d, %d, %d\n", x, y, z);
    printf("Todos iguais? %s\n", igual ? "Sim (1)" : "Não (0)");
    
    return 0;
}


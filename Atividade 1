#include <stdio.h>
#include <string.h>

#define TAM 10

struct Aluno {
    char nome[50];
    int matricula;
    float media;
};

int main() {
    struct Aluno alunos[TAM];
    struct Aluno aprovados[TAM];
    struct Aluno reprovados[TAM];

    int contAprov = 0, contReprov = 0;

    // Leitura dos dados
    for (int i = 0; i < TAM; i++) {
        printf("\nAluno %d\n", i + 1);

        printf("Nome: ");
        scanf(" %[^\n]", alunos[i].nome);

        printf("Matricula: ");
        scanf("%d", &alunos[i].matricula);

        printf("Media: ");
        scanf("%f", &alunos[i].media);
    }

    // Separação
    for (int i = 0; i < TAM; i++) {
        if (alunos[i].media >= 5.0) {
            aprovados[contAprov++] = alunos[i];
        } else {
            reprovados[contReprov++] = alunos[i];
        }
    }

    // Exibir aprovados
    printf("\n--- APROVADOS ---\n");
    for (int i = 0; i < contAprov; i++) {
        printf("Nome: %s | Matricula: %d | Media: %.2f\n",
               aprovados[i].nome,
               aprovados[i].matricula,
               aprovados[i].media);
    }

    // Exibir reprovados
    printf("\n--- REPROVADOS ---\n");
    for (int i = 0; i < contReprov; i++) {
        printf("Nome: %s | Matricula: %d | Media: %.2f\n",
               reprovados[i].nome,
               reprovados[i].matricula,
               reprovados[i].media);
    }

    return 0;
}
